# Variables de docker-compose.yml. Copia este archivo a .env y completa los valores obligatorios.

# Postgres (puerto del host: 5433)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskmate_db

# Obligatorias: sin ellas el compose no arranca.
JWT_SECRET=tu_jwt_secret_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Orígenes permitidos por CORS en ambos backends (lista separada por comas).
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Opcionales. Sin SMTP el backend Node no puede enviar códigos de acceso (send-code responde 500).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TaskMate AI <no-reply@taskmate.ai>"
